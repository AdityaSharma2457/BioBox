{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "biobox",
	"main": "./server/worker.ts",
	"compatibility_date": "2026-11-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"secrets": {
		"required": ["JWT_SECRET"]
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bio-box-production",
			"database_id": "e0414f67-e8ea-49ab-a05f-10183467aa88",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
